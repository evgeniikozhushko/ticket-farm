# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/
MONGODB_DB_NAME=ticket_farm

# App
APP_URL=https://ticketfarm.ca

# Public registration abuse controls
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<Cloudflare Turnstile site key>
TURNSTILE_SECRET_KEY=<matching Cloudflare Turnstile secret key>
# Exact hostnames, without scheme or port. Include each preview hostname used for smoke tests.
TURNSTILE_ALLOWED_HOSTNAMES=ticketfarm.ca,preview.ticketfarm.ca
# Optional shared-IP attempts per hour (default 500; supervised events only).
# PUBLIC_REGISTRATION_IP_ATTEMPT_LIMIT=500

# Resend (email)
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...

# Inngest (background jobs)
# Required in Vercel production for winner email dispatch/retry jobs.
INNGEST_EVENT_KEY=evt_...
INNGEST_SIGNING_KEY=signkey_...

# Clerk (Phase 1 — auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard/lottery
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
# Comma-separated Clerk user IDs allowed to access /platform/*
PLATFORM_ADMIN_USER_IDS=user_...

# Stripe (Phase 3 — billing)
# Create products/prices in Stripe Dashboard before filling these in.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Leave the three STRIPE_*_PRICE_ID vars unset in production during private beta;
# the billing page falls through to "Available after beta." and hides checkout.
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_SCALE_PRICE_ID=price_...
